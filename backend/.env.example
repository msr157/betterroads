# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# PostgreSQL connection string (provided by Dokploy for the betterroads_db instance).
DATABASE_URL=postgres://gitea:CHANGE_ME@postgres-host:5432/betterroads_db

# Social-proof baseline added to the displayed waitlist counter.
# The real DB count stays truthful; this only affects the number shown to visitors.
# Default 0 = show only real signups.
SIGNUP_BASELINE=0

# Port the Hono server binds to (Dokploy / Traefik expects 3000).
PORT=3000

# Allowed CORS origins (comma-separated, no trailing slash).
# Include public and administrator origins in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://betterroads.org,https://www.betterroads.org,https://admin.betterroads.org,https://betterroads.rackops.in

# Set to "0" if you expose Node directly (without nginx/Traefik in front)
# so that spoofed X-Forwarded-For headers cannot bypass rate limiting.
TRUST_PROXY=1

# OAuth audiences accepted by Google token verification. Include Android
# release/debug IDs and the Web ID Expo uses to request an ID token.
# GOOGLE_ANDROID_CLIENT_IDS is retained as a backwards-compatible fallback.
GOOGLE_CLIENT_IDS=000000000000-android.apps.googleusercontent.com,000000000000-web.apps.googleusercontent.com

# Pepper for hashed bearer credentials. Generate with `openssl rand -hex 32`.
SESSION_SECRET=replace-with-64-random-hex-characters

# Used once only when the administrators table is empty. The password must be
# at least 12 characters; later changes are made in the admin security screen.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-long-random-password
ADMIN_BOOTSTRAP_NAME=BetterRoads Administrator
ADMIN_BOOTSTRAP_EMAIL=admin@example.org
