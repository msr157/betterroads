{
  "name": "@betterroads/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.cjs --external:pg-native && node -e \"require('fs').rmSync('dist/index.js',{force:true})\"",
    "start": "node dist/index.cjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "gen:disposable": "node scripts/gen-disposable.mjs",
    "collection:cleanup": "tsx scripts/cleanup-collection-objects.ts",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@aws-sdk/s3-request-presigner": "^3.1123.0",
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.8.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.7.11",
    "postgres": "^3.4.5",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^20.19.2",
    "drizzle-kit": "^0.31.1",
    "esbuild": "^0.25.5",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
