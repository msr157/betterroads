{
  "expo": {
    "name": "BetterRoads",
    "slug": "betterroads",
    "version": "1.0.1",
    "orientation": "portrait",
    "scheme": "betterroads",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0a0a0a",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "org.betterroads.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BetterRoads records your route while you ride so road quality can be scored. Location is only collected during a journey you start.",
        "NSMotionUsageDescription": "Motion sensors detect potholes and rough patches while you ride."
      }
    },
    "android": {
      "package": "org.betterroads.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BetterRoads records your route while you ride so road quality can be scored.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "backgroundColor": "#0a0a0a"
        }
      ],
      "@react-native-google-signin/google-signin"
    ]
  }
}
