# Embedded into the Android bundle at build time; OAuth client IDs are public
# identifiers, not secrets.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=000000000000-android.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-web.apps.googleusercontent.com

# Production defaults to https://betterroads.org. Use a LAN address for a
# physical device talking to a local backend.
# EXPO_PUBLIC_API_URL=http://192.168.1.5:3000
